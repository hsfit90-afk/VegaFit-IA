# GEMINI_API_KEY: chave da API do Gemini, usada por todas as 6 rotas de IA.
# Obtenha em aistudio.google.com/apikey. NAO e a assinatura do app Gemini — a API
# tem cobranca e chave proprias.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_TPM_LIMIT: teto de tokens/minuto da conta, usado pelo throttle (utils/rate-limit.ts).
# Padrao 250000 (free tier da familia Flash). Confirme o seu em aistudio.google.com/rate-limit.
AI_TPM_LIMIT="250000"

# AI_MAX_QUEUE_WAIT_MS: quanto uma requisicao espera por capacidade antes de devolver 429.
AI_MAX_QUEUE_WAIT_MS="10000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Midia dos exercicios usa o Supabase Storage (bucket exercise-media), nao o R2.
# As variaveis R2_* foram removidas junto com a dependencia @aws-sdk/client-s3,
# que estava instalada e nunca era usada por nenhum arquivo.

